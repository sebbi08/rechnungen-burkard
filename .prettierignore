# Prettier already honours .gitignore, so node_modules/, dist/, bin/, obj/,
# data/ and test-results/ need no entry here. What follows is the rest.

# CSharpier owns the backend (scripts/csharpier.sh). Without this Prettier
# reformats the .csproj files too, which would put two formatters in one
# directory and leave it unclear which one a file answers to.
backend/

# Generated by scripts/changelog-entry.sh and scripts/prepend-changelog.sh.
# Reformatting it would fight the release scripts on every release.
CHANGELOG.md

# npm writes these; they are not ours to format.
package-lock.json

# Playwright output, and the worktrees the harness creates. Neither is
# gitignored, so without this Prettier would walk into both.
e2e/playwright-report/
.claude/worktrees/
