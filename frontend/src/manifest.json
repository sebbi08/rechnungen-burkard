{
  "_version": "2.0.0",
  "sap.app": {
    "id": "burkard.invoicing",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "${version}"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "invoicing": {
        "uri": "/odata/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "burkard.invoicing.view.App",
      "type": "XML",
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.151.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.ui.unified": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "burkard.invoicing.i18n.i18n",
          "supportedLocales": [
            "",
            "en"
          ],
          "fallbackLocale": ""
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "path": "burkard.invoicing.view",
        "viewType": "XML",
        "controlId": "app",
        "controlAggregation": "pages"
      },
      "routes": [
        {
          "name": "home",
          "pattern": "",
          "target": [
            "home"
          ]
        },
        {
          "name": "settings",
          "pattern": "settings",
          "target": [
            "settings"
          ]
        },
        {
          "name": "items",
          "pattern": "items",
          "target": [
            "items"
          ]
        },
        {
          "name": "recipients",
          "pattern": "recipients",
          "target": [
            "recipients"
          ]
        },
        {
          "name": "invoices",
          "pattern": "invoices",
          "target": [
            "invoices"
          ]
        },
        {
          "name": "invoiceDetail",
          "pattern": "invoices/{rootId}",
          "target": [
            "invoiceDetail"
          ]
        },
        {
          "name": "graves",
          "pattern": "graves",
          "target": [
            "graves"
          ]
        },
        {
          "name": "graveDetail",
          "pattern": "graves/{graveId}",
          "target": [
            "graveDetail"
          ]
        },
        {
          "name": "importExport",
          "pattern": "import-export",
          "target": [
            "importExport"
          ]
        }
      ],
      "targets": {
        "home": {
          "name": "Home",
          "level": 0,
          "type": "View"
        },
        "settings": {
          "name": "Settings",
          "level": 0,
          "type": "View"
        },
        "items": {
          "name": "Items",
          "level": 0,
          "type": "View"
        },
        "recipients": {
          "name": "Recipients",
          "level": 0,
          "type": "View"
        },
        "invoices": {
          "name": "Invoices",
          "level": 0,
          "type": "View"
        },
        "invoiceDetail": {
          "name": "InvoiceDetail",
          "level": 1,
          "type": "View"
        },
        "graves": {
          "name": "Graves",
          "level": 0,
          "type": "View"
        },
        "graveDetail": {
          "name": "GraveDetail",
          "level": 1,
          "type": "View"
        },
        "importExport": {
          "name": "ImportExport",
          "level": 0,
          "type": "View"
        }
      }
    }
  }
}
