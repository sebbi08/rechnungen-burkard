<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
    controllerName="burkard.invoicing.controller.Items" displayBlock="true">
    <Page title="{i18n>menuItems}" titleLevel="H1" showNavButton="true"
        navButtonPress=".onNavBack" class="sapUiResponsiveContentPadding">
        <subHeader>
            <Toolbar>
                <SearchField width="16rem" search=".onSearch" placeholder="{i18n>searchByNumber}" />
                <ToolbarSpacer />
                <Button text="{i18n>createItem}" press=".onCreateItem" type="Emphasized" />
            </Toolbar>
        </subHeader>
        <content>
            <Table id="itemsTable" class="sapUiSmallMarginTop"
                items="{path: 'odata>/InvoiceItems', parameters: {$orderby: 'Id desc'}}">
                        <columns>
                            <Column><Text text="{i18n>itemNumber}" /></Column>
                            <Column><Text text="{i18n>itemDescription}" /></Column>
                            <Column><Text text="{i18n>vatRate}" /></Column>
                            <Column><Text text="{i18n>itemDefaultPrice}" /></Column>
                            <Column />
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{odata>Number}" />
                                    <Text text="{odata>Description}" />
                                    <Text text="{odata>VatRate}" />
                                    <Text text="{odata>DefaultPrice}" />
                                    <Button text="{i18n>edit}" press=".onEditItem" type="Transparent" />
                                </cells>
                            </ColumnListItem>
                        </items>
            </Table>
        </content>
    </Page>
</mvc:View>
