<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    controllerName="burkard.invoicing.controller.Items"
    displayBlock="true"
>
    <Page
        title="{i18n>menuItems}"
        titleLevel="H1"
        showNavButton="true"
        navButtonPress=".onNavBack"
        class="sapUiResponsiveContentPadding"
    >
        <subHeader>
            <!-- OverflowToolbar so a narrow screen moves actions into the "..."
                 menu instead of truncating their labels -->
            <OverflowToolbar id="itemsToolbar">
                <SearchField width="16rem" search=".onSearch" placeholder="{i18n>searchByNumber}">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" />
                    </layoutData>
                </SearchField>
                <ToolbarSpacer />
                <Button text="{i18n>createItem}" press=".onCreateItem" type="Emphasized">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="High" />
                    </layoutData>
                </Button>
            </OverflowToolbar>
        </subHeader>
        <content>
            <!-- autoPopinMode collapses the less important columns into a pop-in
                 block below the row as the screen gets narrower -->
            <Table
                id="itemsTable"
                class="sapUiSmallMarginTop"
                autoPopinMode="true"
                popinLayout="Block"
                items="{
                    path: 'odata>/InvoiceItems',
                    parameters: {$orderby: 'Id desc'},
                    boundFilters: {and: false, filters: [
                        {path: 'Number', operator: 'Contains', value1: '{view>/searchTerm}'},
                        {path: 'Description', operator: 'Contains', value1: '{view>/searchTerm}'}
                    ]}
                }"
                noDataText="{i18n>noData}"
            >
                <columns>
                    <Column importance="High">
                        <Text text="{i18n>itemNumber}" />
                    </Column>
                    <Column importance="Medium" popinDisplay="Inline">
                        <Text text="{i18n>itemDescription}" />
                    </Column>
                    <Column importance="Low" popinDisplay="Inline">
                        <Text text="{i18n>vatRate}" />
                    </Column>
                    <Column importance="Medium" popinDisplay="Inline">
                        <Text text="{i18n>itemDefaultPrice}" />
                    </Column>
                    <Column importance="Low" popinDisplay="WithoutHeader" />
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{odata>Number}" />
                            <Text text="{odata>Description}" />
                            <Text text="{odata>VatRate}" />
                            <Text text="{odata>DefaultPrice}" />
                            <Button text="{i18n>edit}" press=".onEditItem" type="Transparent" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
