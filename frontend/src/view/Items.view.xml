<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core"
    controllerName="burkard.invoicing.controller.Items" displayBlock="true">
    <tnt:ToolPage>
        <tnt:sideContent>
            <tnt:SideNavigation>
                <tnt:item>
                    <core:Fragment fragmentName="burkard.invoicing.view.fragments.Navigation" type="XML" />
                </tnt:item>
            </tnt:SideNavigation>
        </tnt:sideContent>
        <tnt:mainContents>
            <Page title="{i18n>menuItems}" titleLevel="H1">
                <subHeader>
                    <Toolbar>
                        <SearchField width="16rem" search="onSearch" placeholder="{i18n>searchByNumber}" />
                        <ToolbarSpacer />
                        <Button text="{i18n>createItem}" press="onCreateItem" type="Emphasized" />
                    </Toolbar>
                </subHeader>
                <content>
                    <Table id="itemsTable" items="{path: 'odata>/InvoiceItems', parameters: {$orderby: 'Id desc'}}">
                        <columns>
                            <Column><Text text="{i18n>itemNumber}" /></Column>
                            <Column><Text text="{i18n>itemDescription}" /></Column>
                            <Column><Text text="{i18n>vatRate}" /></Column>
                            <Column><Text text="{i18n>itemDefaultPrice}" /></Column>
                            <Column />
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{odata>Number}" />
                                    <Text text="{odata>Description}" />
                                    <Text text="{odata>VatRate}" />
                                    <Text text="{odata>DefaultPrice}" />
                                    <Button text="{i18n>edit}" press="onEditItem" type="Transparent" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
            </Page>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
