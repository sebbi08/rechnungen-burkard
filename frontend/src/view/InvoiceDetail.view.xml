<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    controllerName="burkard.invoicing.controller.InvoiceDetail"
    displayBlock="true"
>
    <Page
        id="invoiceDetailPage"
        title="{i18n>invoiceDetailTitle}"
        titleLevel="H1"
        showNavButton="true"
        navButtonPress=".onNavBack"
        class="sapUiResponsiveContentPadding"
    >
        <headerContent>
            <ObjectStatus
                text="{path: 'detail>/paidOn', formatter: '.paidStatusText'}"
                state="{path: 'detail>/paidOn', formatter: '.paidStatusState'}"
                class="sapUiSmallMarginEnd"
            />
            <Button
                icon="{path: 'detail>/paidOn', formatter: '.paidActionIcon'}"
                tooltip="{path: 'detail>/paidOn', formatter: '.paidActionTooltip'}"
                press=".onTogglePaid"
            />
            <Button
                icon="sap-icon://edit"
                enabled="{path: 'detail>/paidOn', formatter: '.paidEditEnabled'}"
                tooltip="{path: 'detail>/paidOn', formatter: '.paidEditTooltip'}"
                press=".onEditInvoice"
            />
        </headerContent>
        <content>
            <VBox class="sapUiSmallMarginTop">
                <Title text="{detail>/invoiceNumber}" level="H2" />
                <Text text="{detail>/recipientName}" class="sapUiTinyMarginTop" />
                <!-- the address is stored with line breaks, as it is printed -->
                <Text text="{detail>/recipientAddress}" renderWhitespace="true" />
            </VBox>
            <!-- one panel per revision, newest first; the history stays collapsed.
                 RevisionPanel is shared with GraveInvoiceDetail.view.xml as the
                 aggregation-binding template. -->
            <VBox items="{detail>/revisions}">
                <core:Fragment
                    fragmentName="burkard.invoicing.view.fragments.RevisionPanel"
                    type="XML"
                />
            </VBox>
        </content>
    </Page>
</mvc:View>
