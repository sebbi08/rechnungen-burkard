<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <Dialog title="{i18n>generateInvoices}" stretch="{device>/system/phone}" contentWidth="16rem">
        <content>
            <VBox class="sapUiMediumMargin">
                <Label text="{i18n>halfYear}" labelFor="genYear" />
                <Select id="genYear" width="100%"
                    items="{generateDraft>/yearOptions}" selectedKey="{generateDraft>/year}">
                    <core:Item key="{generateDraft>key}" text="{generateDraft>text}" />
                </Select>
                <Select id="genHalf" width="100%" selectedKey="{generateDraft>/half}">
                    <core:Item key="1" text="H1" />
                    <core:Item key="2" text="H2" />
                </Select>
            </VBox>
        </content>
        <beginButton>
            <Button text="{i18n>generateNow}" type="Emphasized" press=".onGenerateDialogSave" />
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press=".onGenerateDialogCancel" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
