<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <!-- stretch like the other dialogs of this app, so a phone gets the full
         screen instead of a window with fields cut off at its edges -->
    <!-- no field precedes the table, so the dialog's default first-focusable-element
         behaviour would otherwise auto-focus the first row's ComboBox on open; that
         makes the row "active" for keyboard grid navigation, which gives it an
         accessible name concatenating every cell's label — including "Preis" — and
         breaks getByLabel("Preis") by matching the row as well as the input. Focusing
         the dialog itself (its own documented no-target fallback) keeps focus out of
         the table until the user actually interacts with it. -->
    <Dialog
        id="graveInvoiceDialog"
        title="{i18n>graveInvoiceEditTitle}"
        stretch="true"
        initialFocus="graveInvoiceDialog"
    >
        <content>
            <!-- a 2rem margin around a stretched dialog spent 32 of a phone's 393
                 pixels on each side before a field started -->
            <VBox class="sapUiSmallMargin">
                <!-- an invoice per recipient is one grave bill split evenly, so an
                     edit is an edit to the bill: every recipient is revised -->
                <MessageStrip
                    type="Warning"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                    text="{graveInvoiceDraft>/warning}"
                />
                <Table
                    id="graveInvoiceLineTable"
                    items="{graveInvoiceDraft>/lines}"
                    autoPopinMode="true"
                    popinLayout="Block"
                >
                    <columns>
                        <!-- a field's width. Columns without one share the row evenly
                             however long their content is, which with five of them left
                             the number 75 pixels on a tablet — some eight characters -->
                        <Column width="16rem" importance="High">
                            <Text text="{i18n>itemNumber}" />
                        </Column>
                        <!-- as wide as the number, or in the pop-in: a description
                             squeezed into a fifth of a tablet wraps over three lines
                             and takes the number's room with it -->
                        <Column importance="Medium" popinDisplay="Inline" autoPopinWidth="16">
                            <Text text="{i18n>itemDescription}" />
                        </Column>
                        <!-- both hold a short number, so they take a fixed slice
                             instead of an equal share -->
                        <Column width="6rem" importance="High" popinDisplay="Inline">
                            <Text text="{i18n>itemCount}" />
                        </Column>
                        <Column width="8rem" importance="High" popinDisplay="Inline">
                            <Text text="{i18n>itemPrice}" />
                        </Column>
                        <Column importance="Low" popinDisplay="WithoutHeader" />
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <ComboBox
                                    id="graveInvoiceItem"
                                    width="100%"
                                    selectedKey="{graveInvoiceDraft>itemId}"
                                    showSecondaryValues="true"
                                    items="{path: 'odata>/InvoiceItems', parameters: {$orderby: 'Id desc'}, templateShareable: true}"
                                    selectionChange=".onGraveInvoiceItemSelected"
                                >
                                    <core:ListItem
                                        key="{odata>Id}"
                                        text="{odata>Number}"
                                        additionalText="{odata>Description}"
                                    />
                                </ComboBox>
                                <Text text="{graveInvoiceDraft>description}" wrapping="true" />
                                <!-- the grave's count and price, before the split -->
                                <Input
                                    value="{graveInvoiceDraft>count}"
                                    type="Number"
                                    width="5rem"
                                />
                                <VBox>
                                    <!-- Table normally labels a cell's control from its column
                                         header automatically, but only when that control is the
                                         cell's direct child (ColumnListItemRenderer.applyAriaLabelledBy
                                         checks the cell itself for an ariaLabelledBy association) -
                                         wrapping the Input in this VBox to add the VAT marker below
                                         it takes that away, since VBox has no such association. The
                                         explicit ariaLabelledBy below replaces it. -->
                                    <Input
                                        value="{graveInvoiceDraft>unitPrice}"
                                        type="Number"
                                        width="7rem"
                                        placeholder="{graveInvoiceDraft>defaultPrice}"
                                        ariaLabelledBy="graveInvoiceUnitPriceLabel"
                                    />
                                    <core:InvisibleText
                                        id="graveInvoiceUnitPriceLabel"
                                        text="{i18n>itemPrice}"
                                    />
                                    <!-- this row's price is the gross the customer pays -->
                                    <Text
                                        text="{i18n>priceIncludesVatShort}"
                                        visible="{graveInvoiceDraft>priceIncludesVat}"
                                    />
                                </VBox>
                                <Button
                                    text="{i18n>delete}"
                                    press=".onDeleteGraveInvoiceLine"
                                    type="Transparent"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
                <Button
                    text="{i18n>addLine}"
                    press=".onAddGraveInvoiceLine"
                    class="sapUiSmallMarginTop"
                />
            </VBox>
        </content>
        <beginButton>
            <Button text="{i18n>save}" type="Emphasized" press=".onGraveInvoiceDialogSave" />
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press=".onGraveInvoiceDialogCancel" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
