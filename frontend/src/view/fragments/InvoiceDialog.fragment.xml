<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <Dialog id="invoiceDialog" title="{i18n>createInvoice}" stretch="true">
        <content>
            <!-- a 2rem margin around a stretched dialog spent 32 of a phone's 393
                 pixels on each side before a field started -->
            <VBox class="sapUiSmallMargin">
                <Label text="{i18n>recipientName}" labelFor="recipient" />
                <HBox wrap="Wrap" alignItems="Center">
                    <!-- typeahead over the recipients, like the item field below.
                         Two-way, and a ComboBox selects nothing on its own: the
                         draft is what the save reads, so what is on screen is
                         always what the draft holds. -->
                    <ComboBox
                        id="recipient"
                        width="100%"
                        showSecondaryValues="true"
                        items="{path: 'odata>/Recipients', parameters: {$orderby: 'Id desc'}}"
                        selectedKey="{invoiceDraft>/recipientId}"
                    >
                        <!-- names are long, so the field takes what the button leaves
                             of the line rather than a fixed slice of it; on a phone the
                             button wraps away and it gets the whole row -->
                        <layoutData>
                            <FlexItemData growFactor="1" baseSize="20rem" maxWidth="30rem" />
                        </layoutData>
                        <core:ListItem
                            key="{odata>Id}"
                            text="{odata>Name}"
                            additionalText="{path: 'odata>Address', formatter: '.formatAddressLine'}"
                        />
                    </ComboBox>
                    <Button
                        text="{i18n>newRecipient}"
                        press=".onNewRecipient"
                        type="Transparent"
                        class="sapUiTinyMarginBegin"
                    />
                </HBox>
                <Table
                    id="lineTable"
                    items="{invoiceDraft>/lines}"
                    autoPopinMode="true"
                    popinLayout="Block"
                >
                    <columns>
                        <!-- a field's width. Columns without one share the row evenly
                             however long their content is, which left the number about
                             ten characters — on every screen, not only a phone -->
                        <Column width="16rem" importance="High">
                            <Text text="{i18n>itemNumber}" />
                        </Column>
                        <!-- as wide as the number, or in the pop-in: a description
                             squeezed into a quarter of a tablet wraps over three lines
                             and takes the number's room with it -->
                        <Column importance="Medium" popinDisplay="Inline" autoPopinWidth="16">
                            <Text text="{i18n>itemDescription}" />
                        </Column>
                        <!-- both hold a short number, so they take a fixed slice
                             instead of an equal share -->
                        <Column width="6rem" importance="High" popinDisplay="Inline">
                            <Text text="{i18n>itemCount}" />
                        </Column>
                        <Column width="8rem" importance="High" popinDisplay="Inline">
                            <Text text="{i18n>itemPrice}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <ComboBox
                                    id="lineItem"
                                    width="100%"
                                    selectedKey="{invoiceDraft>itemId}"
                                    showSecondaryValues="true"
                                    items="{path: 'odata>/InvoiceItems', parameters: {$orderby: 'Id desc'}, templateShareable: true}"
                                    selectionChange=".onLineItemSelected"
                                >
                                    <core:ListItem
                                        key="{odata>Id}"
                                        text="{odata>Number}"
                                        additionalText="{odata>Description}"
                                    />
                                </ComboBox>
                                <Text text="{invoiceDraft>description}" wrapping="true" />
                                <!-- a width of their own, or the pop-in gives a count
                                     the whole row to hold one digit -->
                                <Input
                                    value="{invoiceDraft>count}"
                                    type="Number"
                                    width="5rem"
                                    ariaLabel="{i18n>itemCount}"
                                />
                                <!-- pre-filled with the item's default price; clearing it or
                                     typing another one overrides it for this invoice -->
                                <Input
                                    value="{invoiceDraft>unitPrice}"
                                    type="Number"
                                    width="7rem"
                                    placeholder="{invoiceDraft>defaultPrice}"
                                    ariaLabel="{i18n>itemPrice}"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
                <Button text="{i18n>addLine}" press=".onAddLine" />
            </VBox>
        </content>
        <beginButton>
            <Button text="{i18n>save}" type="Emphasized" press=".onInvoiceDialogSave" />
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press=".onInvoiceDialogCancel" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
