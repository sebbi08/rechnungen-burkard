<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <Dialog id="invoiceDialog" title="{i18n>createInvoice}" stretch="true">
        <content>
            <VBox class="sapUiMediumMargin">
                <Label text="{i18n>recipientName}" labelFor="recipient" />
                <HBox wrap="Wrap" alignItems="Center">
                    <!-- typeahead over the recipients, like the item field below.
                         Two-way, and a ComboBox selects nothing on its own: the
                         draft is what the save reads, so what is on screen is
                         always what the draft holds. -->
                    <ComboBox
                        id="recipient"
                        width="20rem"
                        showSecondaryValues="true"
                        items="{path: 'odata>/Recipients', parameters: {$orderby: 'Id desc'}}"
                        selectedKey="{invoiceDraft>/recipientId}"
                    >
                        <core:ListItem
                            key="{odata>Id}"
                            text="{odata>Name}"
                            additionalText="{path: 'odata>Address', formatter: '.formatAddressLine'}"
                        />
                    </ComboBox>
                    <Button
                        text="{i18n>newRecipient}"
                        press=".onNewRecipient"
                        type="Transparent"
                        class="sapUiTinyMarginBegin"
                    />
                </HBox>
                <Table
                    id="lineTable"
                    items="{invoiceDraft>/lines}"
                    autoPopinMode="true"
                    popinLayout="Block"
                >
                    <columns>
                        <Column importance="High">
                            <Text text="{i18n>itemNumber}" />
                        </Column>
                        <Column importance="Medium" popinDisplay="Inline">
                            <Text text="{i18n>itemDescription}" />
                        </Column>
                        <Column importance="High" popinDisplay="Inline">
                            <Text text="{i18n>itemCount}" />
                        </Column>
                        <Column importance="High" popinDisplay="Inline">
                            <Text text="{i18n>itemPrice}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <ComboBox
                                    id="lineItem"
                                    width="10rem"
                                    selectedKey="{invoiceDraft>itemId}"
                                    showSecondaryValues="true"
                                    items="{path: 'odata>/InvoiceItems', parameters: {$orderby: 'Id desc'}, templateShareable: true}"
                                    selectionChange=".onLineItemSelected"
                                >
                                    <core:ListItem
                                        key="{odata>Id}"
                                        text="{odata>Number}"
                                        additionalText="{odata>Description}"
                                    />
                                </ComboBox>
                                <Text text="{invoiceDraft>description}" wrapping="true" />
                                <Input
                                    value="{invoiceDraft>count}"
                                    type="Number"
                                    ariaLabel="{i18n>itemCount}"
                                />
                                <!-- pre-filled with the item's default price; clearing it or
                                     typing another one overrides it for this invoice -->
                                <Input
                                    value="{invoiceDraft>unitPrice}"
                                    type="Number"
                                    placeholder="{invoiceDraft>defaultPrice}"
                                    ariaLabel="{i18n>itemPrice}"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
                <Button text="{i18n>addLine}" press=".onAddLine" />
            </VBox>
        </content>
        <beginButton>
            <Button text="{i18n>save}" type="Emphasized" press=".onInvoiceDialogSave" />
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press=".onInvoiceDialogCancel" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
