<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <Dialog id="invoiceDialog" title="{i18n>createInvoice}" stretch="true">
        <content>
            <VBox class="sapUiMediumMargin">
                <Label text="{i18n>recipientName}" labelFor="recipient" />
                <HBox>
                    <Select id="recipient" width="20rem"
                        items="{path: 'odata>/Recipients', parameters: {$orderby: 'Id desc'}}"
                        selectedKey="{invoiceDraft>/recipientId}">
                        <core:Item key="{odata>Id}" text="{odata>Name}" />
                    </Select>
                    <Button text="{i18n>newRecipient}" press=".onNewRecipient" type="Transparent"
                        class="sapUiTinyMarginBegin" />
                </HBox>
                <Table id="lineTable" items="{invoiceDraft>/lines}">
                    <columns>
                        <Column><Text text="{i18n>itemNumber}" /></Column>
                        <Column><Text text="{i18n>itemDescription}" /></Column>
                        <Column><Text text="{i18n>itemCount}" /></Column>
                        <Column><Text text="{i18n>itemPrice}" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Input id="lineItem" width="10rem" showSuggestion="true"
                                    value="{invoiceDraft>itemNumber}"
                                    suggestionItems="{path: 'odata>/InvoiceItems', parameters: {$orderby: 'Id desc'}, templateShareable: true}"
                                    suggestionItemSelected=".onLineItemSelected">
                                    <suggestionItems>
                                        <core:Item key="{odata>Id}"
                                            text="{= ${odata>Number} + ' — ' + ${odata>Description} }" />
                                    </suggestionItems>
                                </Input>
                                <Text text="{invoiceDraft>description}" wrapping="true" />
                                <Input value="{invoiceDraft>count}" type="Number" ariaLabel="{i18n>itemCount}" />
                                <Input value="{invoiceDraft>unitPrice}" type="Number" ariaLabel="{i18n>itemPrice}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
                <Button text="{i18n>addLine}" press=".onAddLine" />
            </VBox>
        </content>
        <beginButton>
            <Button text="{i18n>save}" type="Emphasized" press=".onInvoiceDialogSave" />
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press=".onInvoiceDialogCancel" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
