<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <Dialog
        id="graveDialog"
        stretch="true"
        title="{= ${graveDraft>/Id} === null ? ${i18n>createGrave} : ${i18n>editGrave} }"
    >
        <content>
            <!-- one gutter, not three: the dialog is stretched, so a 2rem margin
                 around a panel that pads its own content again spent 48 of a
                 phone's 393 pixels on each side before a field started -->
            <VBox class="sapUiSmallMargin">
                <!-- an edit changes the grave, never an invoice already issued
                     from it; the invoices are snapshots -->
                <MessageStrip
                    type="Warning"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                    text="{i18n>graveEditWarning}"
                    visible="{= ${graveDraft>/Id} !== null }"
                />
                <Label text="{i18n>graveNumber}" labelFor="graveNumber" />
                <Input id="graveNumber" width="16rem" value="{graveDraft>/GraveNumber}" />
                <Label text="{i18n>startDate}" labelFor="graveStart" />
                <DatePicker
                    id="graveStart"
                    width="16rem"
                    displayFormat="yyyy-MM-dd"
                    valueFormat="yyyy-MM-dd"
                    value="{graveDraft>/StartDate}"
                />
                <Label text="{i18n>endDate}" labelFor="graveEnd" />
                <DatePicker
                    id="graveEnd"
                    width="16rem"
                    displayFormat="yyyy-MM-dd"
                    valueFormat="yyyy-MM-dd"
                    value="{graveDraft>/EndDate}"
                />
                <!-- the panel drops its own side padding on a phone, so the table
                     lines up with the fields above instead of behind them -->
                <Panel headerText="{i18n>graveItems}" class="sapUiResponsiveContentPadding">
                    <Table
                        id="graveItemsTable"
                        items="{graveDraft>/Items}"
                        autoPopinMode="true"
                        popinLayout="Block"
                    >
                        <columns>
                            <!-- a field's width, like the ones above. Columns without one
                                 share the row evenly however long their content is, which
                                 left the number about ten characters on a small screen -->
                            <Column width="16rem" importance="High">
                                <Text text="{i18n>itemNumber}" />
                            </Column>
                            <!-- as wide as the number, or in the pop-in: a description
                                 squeezed into a third of a tablet wraps over three
                                 lines and takes the number's room with it -->
                            <Column importance="Medium" popinDisplay="Inline" autoPopinWidth="16">
                                <Text text="{i18n>itemDescription}" />
                            </Column>
                            <!-- both hold a short number, so they take a fixed slice
                                 instead of an equal share; the rest goes to the two
                                 columns whose content is as long as the data is -->
                            <Column width="6rem" importance="High" popinDisplay="Inline">
                                <Text text="{i18n>itemCount}" />
                            </Column>
                            <Column width="8rem" importance="High" popinDisplay="Inline">
                                <Text text="{i18n>itemPrice}" />
                            </Column>
                            <Column importance="Low" popinDisplay="WithoutHeader" />
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <ComboBox
                                        id="graveItem"
                                        width="100%"
                                        selectedKey="{graveDraft>itemId}"
                                        showSecondaryValues="true"
                                        items="{path: 'odata>/InvoiceItems', parameters: {$orderby: 'Id desc'}, templateShareable: true}"
                                        selectionChange=".onGraveItemSelected"
                                    >
                                        <core:ListItem
                                            key="{odata>Id}"
                                            text="{odata>Number}"
                                            additionalText="{odata>Description}"
                                        />
                                    </ComboBox>
                                    <Text text="{graveDraft>description}" wrapping="true" />
                                    <Input
                                        value="{graveDraft>count}"
                                        type="Number"
                                        width="5rem"
                                        ariaLabel="{i18n>itemCount}"
                                    />
                                    <!-- pre-filled with the item's default price, as in the
                                         invoice dialog; clearing it means "use the item's
                                         default price", which the placeholder shows -->
                                    <Input
                                        value="{graveDraft>unitPrice}"
                                        type="Number"
                                        width="7rem"
                                        placeholder="{graveDraft>defaultPrice}"
                                        ariaLabel="{i18n>itemPrice}"
                                    />
                                    <Button
                                        text="{i18n>delete}"
                                        press=".onDeleteItemLink"
                                        type="Transparent"
                                    />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <Button
                        text="{i18n>addLine}"
                        press=".onAddItemLink"
                        class="sapUiSmallMarginTop"
                    />
                </Panel>
                <Panel headerText="{i18n>graveRecipients}" class="sapUiResponsiveContentPadding">
                    <!-- the even split across them is baked into every invoice the
                         grave has generated, so the set is fixed at creation -->
                    <MessageStrip
                        type="Information"
                        showIcon="true"
                        class="sapUiSmallMarginBottom"
                        text="{i18n>graveRecipientsFixed}"
                        visible="{= ${graveDraft>/Id} !== null }"
                    />
                    <Table
                        id="graveRecipientsTable"
                        items="{graveDraft>/Recipients}"
                        autoPopinMode="true"
                        popinLayout="Block"
                    >
                        <columns>
                            <!-- names run long; splitting a phone row evenly with the
                                 delete button wrapped them over three lines -->
                            <Column importance="High" autoPopinWidth="16">
                                <Text text="{i18n>recipientName}" />
                            </Column>
                            <Column importance="Low" popinDisplay="WithoutHeader" />
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{graveDraft>name}" />
                                    <Button
                                        text="{i18n>delete}"
                                        press=".onDeleteRecipientLink"
                                        type="Transparent"
                                        visible="{= ${graveDraft>/Id} === null }"
                                    />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <!-- wraps so the select and both buttons stay usable on a phone -->
                    <HBox
                        id="graveRecipientsLink"
                        wrap="Wrap"
                        alignItems="Center"
                        class="sapUiSmallMarginTop"
                        visible="{= ${graveDraft>/Id} === null }"
                    >
                        <!-- forceSelection off for the same reason as the invoice
                             dialog's: what is shown is what the draft holds -->
                        <Select
                            id="linkRecipient"
                            width="100%"
                            forceSelection="false"
                            items="{path: 'odata>/Recipients', parameters: {$orderby: 'Id desc'}}"
                            selectedKey="{graveDraft>/linkRecipientId}"
                            change=".onLinkRecipientChange"
                        >
                            <!-- names are long, so the select takes what the buttons
                                 leave of the line rather than a fixed slice of it; on a
                                 phone the buttons wrap away and it gets the whole row -->
                            <layoutData>
                                <FlexItemData growFactor="1" baseSize="20rem" maxWidth="30rem" />
                            </layoutData>
                            <core:Item key="{odata>Id}" text="{odata>Name}" />
                        </Select>
                        <Button text="{i18n>add}" press=".onAddRecipientLink" />
                        <Button
                            text="{i18n>newRecipient}"
                            press=".onNewRecipient"
                            type="Transparent"
                        />
                    </HBox>
                </Panel>
            </VBox>
        </content>
        <beginButton>
            <Button text="{i18n>save}" type="Emphasized" press=".onGraveDialogSave" />
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press=".onGraveDialogCancel" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
