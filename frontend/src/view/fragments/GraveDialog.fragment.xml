<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <Dialog id="graveDialog" title="{i18n>createGrave}" stretch="true">
        <content>
            <VBox class="sapUiMediumMargin">
                <Label text="{i18n>graveNumber}" labelFor="graveNumber" />
                <Input id="graveNumber" width="16rem" value="{graveDraft>/GraveNumber}" />
                <Label text="{i18n>startDate}" labelFor="graveStart" />
                <DatePicker id="graveStart" width="16rem" displayFormat="yyyy-MM-dd"
                    valueFormat="yyyy-MM-dd" value="{graveDraft>/StartDate}" />
                <Label text="{i18n>endDate}" labelFor="graveEnd" />
                <DatePicker id="graveEnd" width="16rem" displayFormat="yyyy-MM-dd"
                    valueFormat="yyyy-MM-dd" value="{graveDraft>/EndDate}" />
                <Panel headerText="{i18n>graveItems}">
                    <Table id="graveItemsTable" items="{graveDraft>/Items}">
                        <columns>
                            <Column><Text text="{i18n>itemNumber}" /></Column>
                            <Column><Text text="{i18n>itemCount}" /></Column>
                            <Column />
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{graveDraft>Number}" />
                                    <Text text="{graveDraft>Count}" />
                                    <Button text="{i18n>delete}" press=".onDeleteItemLink" type="Transparent" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <HBox class="sapUiSmallMarginTop">
                        <Select id="linkItem" width="12rem"
                            items="{path: 'odata>/InvoiceItems', parameters: {$orderby: 'Id desc'}}">
                            <core:Item key="{odata>Id}" text="{odata>Number}" />
                        </Select>
                        <Input id="linkCount" type="Number" width="6rem" value="1" ariaLabel="{i18n>itemCount}" />
                        <Button text="{i18n>add}" press=".onAddItemLink" />
                    </HBox>
                </Panel>
                <Panel headerText="{i18n>graveRecipients}">
                    <Table id="graveRecipientsTable" items="{graveDraft>/Recipients}">
                        <columns>
                            <Column><Text text="{i18n>recipientName}" /></Column>
                            <Column />
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{graveDraft>Name}" />
                                    <Button text="{i18n>delete}" press=".onDeleteRecipientLink" type="Transparent" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <HBox class="sapUiSmallMarginTop">
                        <Select id="linkRecipient" width="12rem"
                            items="{path: 'odata>/Recipients', parameters: {$orderby: 'Id desc'}}">
                            <core:Item key="{odata>Id}" text="{odata>Name}" />
                        </Select>
                        <Button text="{i18n>add}" press=".onAddRecipientLink" />
                        <Button text="{i18n>newRecipient}" press=".onNewRecipient" type="Transparent" />
                    </HBox>
                </Panel>
            </VBox>
        </content>
        <beginButton>
            <Button text="{i18n>save}" type="Emphasized" press=".onGraveDialogSave" />
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press=".onGraveDialogCancel" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
