<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    controllerName="burkard.invoicing.controller.Invoices"
    displayBlock="true"
>
    <Page
        title="{i18n>menuInvoices}"
        titleLevel="H1"
        showNavButton="true"
        navButtonPress=".onNavBack"
        class="sapUiResponsiveContentPadding"
    >
        <subHeader>
            <OverflowToolbar id="invoicesToolbar">
                <SearchField
                    id="invoiceSearch"
                    width="18rem"
                    search=".onSearchInvoices"
                    placeholder="{i18n>searchInvoice}"
                >
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" />
                    </layoutData>
                </SearchField>
                <Label text="{i18n>paymentFilter}" labelFor="paymentFilter">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" group="1" />
                    </layoutData>
                </Label>
                <Select
                    id="paymentFilter"
                    width="10rem"
                    change=".onPaymentFilterChange"
                    selectedKey="{view>/paymentFilter}"
                >
                    <core:Item key="all" text="{i18n>paymentFilterAll}" />
                    <core:Item key="unpaid" text="{i18n>paymentFilterUnpaid}" />
                    <core:Item key="paid" text="{i18n>paymentFilterPaid}" />
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" group="1" />
                    </layoutData>
                </Select>
                <ToolbarSpacer />
                <Button text="{i18n>createInvoice}" press=".onCreateInvoice" type="Emphasized">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="High" />
                    </layoutData>
                </Button>
            </OverflowToolbar>
        </subHeader>
        <content>
            <Table
                id="invoicesTable"
                class="sapUiSmallMarginTop"
                growing="true"
                growingThreshold="50"
                autoPopinMode="true"
                popinLayout="Block"
                items="{path: 'odata>/Invoices', parameters: {$filter: 'GraveId eq null and IsLatestRevision eq true', $orderby: 'Id desc'}}"
                noDataText="{i18n>noData}"
            >
                <columns>
                    <Column importance="High">
                        <Text text="{i18n>invoiceNumber}" />
                    </Column>
                    <Column importance="High" popinDisplay="Inline">
                        <Text text="{i18n>recipientName}" />
                    </Column>
                    <Column importance="Medium" popinDisplay="Inline">
                        <Text text="{i18n>invoiceDate}" />
                    </Column>
                    <Column importance="Medium" popinDisplay="Inline">
                        <Text text="{i18n>revision}" />
                    </Column>
                    <Column importance="High" popinDisplay="Inline">
                        <Text text="{i18n>paidStatus}" />
                    </Column>
                    <!-- wide enough for the five actions to stay on one line -->
                    <Column width="13rem" importance="Low" popinDisplay="WithoutHeader" />
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{odata>InvoiceNumber}" />
                            <Text text="{odata>RecipientName}" />
                            <Text text="{path:'odata>GeneratedAt', formatter:'.formatDate'}" />
                            <HBox>
                                <Text
                                    text="{path: 'odata>InvoiceNumber', formatter: '.formatInvoiceNumber'}"
                                    visible="{= ${odata>RevisionNumber} > 0}"
                                />
                                <Text
                                    text="{path: 'odata>RevisionNumber', formatter: '.formatRevisionBadge'}"
                                    visible="{= ${odata>RevisionNumber} > 0}"
                                    class="sapUiTinyMarginBegin"
                                />
                            </HBox>
                            <ObjectStatus
                                text="{path: 'odata>PaidOn', formatter: '.paidStatusText'}"
                                state="{path: 'odata>PaidOn', formatter: '.paidStatusState'}"
                            />
                            <!-- wraps in the pop-in, where the actions sit
                                         below the row instead of next to it -->
                            <HBox wrap="Wrap">
                                <Button
                                    icon="sap-icon://detail-view"
                                    type="Transparent"
                                    tooltip="{i18n>actionDetails}"
                                    press=".onShowDetails"
                                />
                                <Button
                                    icon="sap-icon://pdf-attachment"
                                    type="Transparent"
                                    tooltip="{i18n>actionDownloadNormal}"
                                    press=".onDownloadNormal"
                                />
                                <Button
                                    icon="sap-icon://copy"
                                    type="Transparent"
                                    tooltip="{i18n>actionDownloadCopy}"
                                    press=".onDownloadCopy"
                                />
                                <Button
                                    icon="sap-icon://edit"
                                    type="Transparent"
                                    enabled="{path: 'odata>PaidOn', formatter: '.paidEditEnabled', targetType: 'any'}"
                                    tooltip="{path: 'odata>PaidOn', formatter: '.paidEditTooltip'}"
                                    press=".onEditInvoice"
                                />
                                <Button
                                    icon="{path: 'odata>PaidOn', formatter: '.paidActionIcon'}"
                                    type="Transparent"
                                    tooltip="{path: 'odata>PaidOn', formatter: '.paidActionTooltip'}"
                                    press=".onTogglePaid"
                                />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
