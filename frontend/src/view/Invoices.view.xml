<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
    controllerName="burkard.invoicing.controller.Invoices" displayBlock="true">
    <Page title="{i18n>menuInvoices}" titleLevel="H1" showNavButton="true"
        navButtonPress=".onNavBack" class="sapUiResponsiveContentPadding">
        <subHeader>
            <!-- the bulk downloads are the first to move into the "..." menu; the
                 create action stays on the toolbar as long as it fits -->
            <OverflowToolbar id="invoicesToolbar">
                <Select id="halfYearFilter" width="12rem" change=".onHalfYearChange">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" />
                    </layoutData>
                </Select>
                <ToolbarSpacer />
                <Button text="{i18n>bulkNormal}" press=".onBulkNormal">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" />
                    </layoutData>
                </Button>
                <Button text="{i18n>bulkCopy}" press=".onBulkCopy">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" />
                    </layoutData>
                </Button>
                <Button text="{i18n>createInvoice}" press=".onCreateInvoice" type="Emphasized">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="High" />
                    </layoutData>
                </Button>
            </OverflowToolbar>
        </subHeader>
        <content>
            <Table id="invoicesTable" class="sapUiSmallMarginTop" growing="true" growingThreshold="50"
                autoPopinMode="true" popinLayout="Block"
                items="{path: 'odata>/Invoices', parameters: {$orderby: 'Id desc'}}"
                noDataText="{i18n>noData}">
                        <columns>
                            <Column importance="High"><Text text="{i18n>invoiceNumber}" /></Column>
                            <Column importance="High" popinDisplay="Inline"><Text text="{i18n>recipientName}" /></Column>
                            <Column importance="Medium" popinDisplay="Inline"><Text text="{i18n>invoiceDate}" /></Column>
                            <Column importance="Medium" popinDisplay="Inline"><Text text="{i18n>revision}" /></Column>
                            <!-- wide enough for the three actions to stay on one line -->
                            <Column width="11rem" importance="Low" popinDisplay="WithoutHeader" />
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{odata>InvoiceNumber}" />
                                    <Text text="{odata>RecipientName}" />
                                    <Text text="{path:'odata>GeneratedAt', formatter:'.formatDate'}" />
                                    <HBox>
                                        <Text text="{path: 'odata>InvoiceNumber', formatter: '.formatInvoiceNumber'}"
                                            visible="{= ${odata>RevisionNumber} > 0}" />
                                        <Text text="{path: 'odata>RevisionNumber', formatter: '.formatRevisionBadge'}"
                                            visible="{= ${odata>RevisionNumber} > 0}" class="sapUiTinyMarginBegin" />
                                    </HBox>
                                    <!-- wraps in the pop-in, where the three actions sit
                                         below the row instead of next to it -->
                                    <HBox wrap="Wrap">
                                        <Button text="{i18n>downloadNormal}" press=".onDownloadNormal" type="Transparent" />
                                        <Button text="{i18n>downloadCopy}" press=".onDownloadCopy" type="Transparent" />
                                        <Button text="{i18n>editInvoice}" press=".onEditInvoice" type="Transparent" />
                                    </HBox>
                                </cells>
                            </ColumnListItem>
                        </items>
            </Table>
        </content>
    </Page>
</mvc:View>
