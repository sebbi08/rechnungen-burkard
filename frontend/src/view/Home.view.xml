<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core"
    controllerName="burkard.invoicing.controller.Home" displayBlock="true">
    <Page showHeader="false" class="sapUiResponsiveContentPadding">
        <content>
            <VBox alignItems="Center" class="sapUiMediumMarginTop sapUiMediumMarginBottom">
                <Title text="{i18n>homeWelcome}" level="H1" textAlign="Center" />
                <Text text="{i18n>homeSubtitle}" textAlign="Center" class="sapUiTinyMarginTop" />
            </VBox>
            <FlexBox id="homeTiles" justifyContent="Center" alignItems="Start" wrap="Wrap"
                class="sapUiMediumMarginBottom">
                <GenericTile class="sapUiTinyMargin" width="11rem" header="{i18n>menuSettings}"
                    press=".onTilePress">
                    <customData>
                        <core:CustomData key="route" value="settings" />
                    </customData>
                    <tileContent>
                        <TileContent>
                            <ImageContent src="sap-icon://settings" />
                        </TileContent>
                    </tileContent>
                </GenericTile>
                <GenericTile class="sapUiTinyMargin" width="11rem" header="{i18n>menuItems}"
                    press=".onTilePress">
                    <customData>
                        <core:CustomData key="route" value="items" />
                    </customData>
                    <tileContent>
                        <TileContent>
                            <ImageContent src="sap-icon://product" />
                        </TileContent>
                    </tileContent>
                </GenericTile>
                <GenericTile class="sapUiTinyMargin" width="11rem" header="{i18n>menuRecipients}"
                    press=".onTilePress">
                    <customData>
                        <core:CustomData key="route" value="recipients" />
                    </customData>
                    <tileContent>
                        <TileContent>
                            <ImageContent src="sap-icon://group-2" />
                        </TileContent>
                    </tileContent>
                </GenericTile>
                <GenericTile class="sapUiTinyMargin" width="11rem" header="{i18n>menuInvoices}"
                    press=".onTilePress">
                    <customData>
                        <core:CustomData key="route" value="invoices" />
                    </customData>
                    <tileContent>
                        <TileContent>
                            <ImageContent src="sap-icon://documents" />
                        </TileContent>
                    </tileContent>
                </GenericTile>
                <GenericTile class="sapUiTinyMargin" width="11rem" header="{i18n>menuGraves}"
                    press=".onTilePress">
                    <customData>
                        <core:CustomData key="route" value="graves" />
                    </customData>
                    <tileContent>
                        <TileContent>
                            <ImageContent src="sap-icon://home-share" />
                        </TileContent>
                    </tileContent>
                </GenericTile>
                <GenericTile class="sapUiTinyMargin" width="11rem" header="{i18n>menuImportExport}"
                    press=".onTilePress">
                    <customData>
                        <core:CustomData key="route" value="importExport" />
                    </customData>
                    <tileContent>
                        <TileContent>
                            <ImageContent src="sap-icon://upload-to-cloud" />
                        </TileContent>
                    </tileContent>
                </GenericTile>
            </FlexBox>
        </content>
    </Page>
</mvc:View>
