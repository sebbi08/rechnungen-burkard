<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    controllerName="burkard.invoicing.controller.Home" displayBlock="true">
    <Page showHeader="false" class="sapUiResponsiveContentPadding">
        <content>
            <VBox alignItems="Center" class="sapUiMediumMarginTop sapUiMediumMarginBottom">
                <Title text="{i18n>homeWelcome}" level="H1" textAlign="Center" />
                <Text text="{i18n>homeSubtitle}" textAlign="Center" class="sapUiTinyMarginTop" />
            </VBox>
            <f:GridContainer id="homeTiles" class="sapUiMediumMarginBottom">
                <f:layout>
                    <f:GridContainerSettings rowSize="11rem" columnSize="11rem" gap="1rem" />
                </f:layout>
                <GenericTile mode="HeaderMode" headerImage="sap-icon://settings"
                    header="{i18n>menuSettings}" subheader="{i18n>tileSettingsSub}"
                    press=".onTilePress">
                    <customData>
                        <core:CustomData key="route" value="settings" />
                    </customData>
                </GenericTile>
                <GenericTile mode="HeaderMode" headerImage="sap-icon://product"
                    header="{i18n>menuItems}" subheader="{i18n>tileItemsSub}"
                    press=".onTilePress">
                    <customData>
                        <core:CustomData key="route" value="items" />
                    </customData>
                </GenericTile>
                <GenericTile mode="HeaderMode" headerImage="sap-icon://group-2"
                    header="{i18n>menuRecipients}" subheader="{i18n>tileRecipientsSub}"
                    press=".onTilePress">
                    <customData>
                        <core:CustomData key="route" value="recipients" />
                    </customData>
                </GenericTile>
                <GenericTile mode="HeaderMode" headerImage="sap-icon://documents"
                    header="{i18n>menuInvoices}" subheader="{i18n>tileInvoicesSub}"
                    press=".onTilePress">
                    <customData>
                        <core:CustomData key="route" value="invoices" />
                    </customData>
                </GenericTile>
                <GenericTile mode="HeaderMode" headerImage="sap-icon://home-share"
                    header="{i18n>menuGraves}" subheader="{i18n>tileGravesSub}"
                    press=".onTilePress">
                    <customData>
                        <core:CustomData key="route" value="graves" />
                    </customData>
                </GenericTile>
            </f:GridContainer>
        </content>
    </Page>
</mvc:View>
