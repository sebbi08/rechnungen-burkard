<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    controllerName="burkard.invoicing.controller.GraveDetail"
    displayBlock="true"
>
    <Page
        id="graveDetailPage"
        title="{i18n>graveDetailTitle}"
        titleLevel="H1"
        showNavButton="true"
        navButtonPress=".onNavBack"
        class="sapUiResponsiveContentPadding"
    >
        <headerContent>
            <Button icon="sap-icon://edit" tooltip="{i18n>editGrave}" press=".onEditGrave" />
        </headerContent>
        <content>
            <VBox class="sapUiSmallMarginTop">
                <Title text="{grave>/GraveNumber}" level="H2" />
                <HBox wrap="Wrap" class="sapUiTinyMarginTop">
                    <ObjectStatus
                        title="{i18n>startDate}"
                        class="sapUiSmallMarginEnd"
                        text="{path: 'grave>/StartDate', formatter: '.formatDate'}"
                    />
                    <ObjectStatus
                        title="{i18n>endDate}"
                        class="sapUiSmallMarginEnd"
                        text="{path: 'grave>/EndDate', formatter: '.formatDate'}"
                    />
                    <ObjectStatus
                        title="{i18n>graveCreatedAt}"
                        class="sapUiSmallMarginEnd"
                        text="{path: 'grave>/CreatedAt', formatter: '.formatDate'}"
                    />
                    <!-- green when this half-year is done, red while it still needs
                         invoices — the same reading as the grave list -->
                    <ObjectStatus
                        title="{grave>/currentHalfYearLabel}"
                        text="{grave>/currentStatusText}"
                        stateAnnouncementText="{grave>/currentStatusAnnouncement}"
                        state="{= ${grave>/currentInvoiced} ? 'Success' : 'Error' }"
                        icon="{= ${grave>/currentInvoiced} ? 'sap-icon://accept' : 'sap-icon://error' }"
                    />
                </HBox>
            </VBox>

            <Panel headerText="{i18n>graveItems}" class="sapUiSmallMarginTop">
                <Table
                    items="{grave>/Items}"
                    autoPopinMode="true"
                    popinLayout="Block"
                    noDataText="{i18n>noData}"
                >
                    <columns>
                        <Column importance="High">
                            <Text text="{i18n>itemNumber}" />
                        </Column>
                        <Column importance="Medium" popinDisplay="Inline">
                            <Text text="{i18n>itemDescription}" />
                        </Column>
                        <Column importance="High" popinDisplay="Inline">
                            <Text text="{i18n>itemCount}" />
                        </Column>
                        <Column importance="High" popinDisplay="Inline">
                            <Text text="{i18n>itemPrice}" />
                        </Column>
                        <Column importance="High" popinDisplay="Inline">
                            <Text text="{i18n>netAmount}" />
                        </Column>
                        <Column importance="High" popinDisplay="Inline">
                            <Text text="{i18n>grossAmount}" />
                        </Column>
                        <!-- the rate and the incl.-VAT flag are the first to fold
                             into the pop-in area on a narrow screen: they qualify
                             the amounts rather than being read off directly -->
                        <Column importance="Low" popinDisplay="Inline">
                            <Text text="{i18n>vatRate}" />
                        </Column>
                        <Column importance="Low" popinDisplay="Inline">
                            <Text text="{i18n>priceIncludesVatColumn}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{grave>Number}" />
                                <Text text="{grave>Description}" wrapping="true" />
                                <Text text="{grave>Count}" />
                                <VBox>
                                    <Text
                                        text="{path: 'grave>Price', formatter: '.formatAmount'}"
                                    />
                                    <!-- billing raised this price: say what was
                                         entered, so the two figures are not read
                                         as a contradiction -->
                                    <ObjectStatus
                                        state="Warning"
                                        visible="{grave>PriceWasRaised}"
                                        text="{parts: ['i18n>enteredPrice', 'grave>EnteredPrice'], formatter: '.formatEnteredPrice'}"
                                    />
                                </VBox>
                                <Text
                                    text="{path: 'grave>NetTotal', formatter: '.formatAmountOrDash'}"
                                />
                                <Text
                                    text="{path: 'grave>GrossTotal', formatter: '.formatAmountOrDash'}"
                                />
                                <Text text="{grave>VatRate}" />
                                <Text
                                    text="{path: 'grave>PriceIncludesVat', formatter: '.formatYesNo'}"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
                <Text
                    text="{i18n>grossRoundingNote}"
                    wrapping="true"
                    class="sapUiTinyMarginTop sapUiTinyMarginBegin"
                />
            </Panel>

            <Panel headerText="{i18n>graveRecipients}" class="sapUiSmallMarginTop">
                <!-- read-only always: the split across them is baked into every
                     invoice the grave has generated -->
                <Table
                    items="{grave>/Recipients}"
                    autoPopinMode="true"
                    popinLayout="Block"
                    noDataText="{i18n>noData}"
                >
                    <columns>
                        <Column importance="High">
                            <Text text="{i18n>recipientName}" />
                        </Column>
                        <Column importance="Medium" popinDisplay="Inline">
                            <Text text="{i18n>recipientAddress}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{grave>Name}" />
                                <Text text="{grave>Address}" renderWhitespace="true" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>

            <Panel headerText="{i18n>graveInvoices}" class="sapUiSmallMarginTop">
                <Table
                    id="graveInvoicesTable"
                    items="{grave>/Invoices}"
                    autoPopinMode="true"
                    popinLayout="Block"
                    noDataText="{i18n>noGraveInvoices}"
                >
                    <columns>
                        <Column importance="High">
                            <Text text="{i18n>halfYear}" />
                        </Column>
                        <Column importance="High" popinDisplay="Inline">
                            <Text text="{i18n>recipientName}" />
                        </Column>
                        <Column importance="Medium" popinDisplay="Inline">
                            <Text text="{i18n>invoiceNumber}" />
                        </Column>
                        <Column importance="Low" popinDisplay="Inline">
                            <Text text="{i18n>invoiceDate}" />
                        </Column>
                        <Column importance="Medium" popinDisplay="Inline">
                            <Text text="{i18n>grossTotal}" />
                        </Column>
                        <Column importance="High" popinDisplay="Inline">
                            <Text text="{i18n>paidStatus}" />
                        </Column>
                        <Column width="13rem" importance="Low" popinDisplay="WithoutHeader" />
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{grave>HalfYear}" />
                                <Text text="{grave>RecipientName}" />
                                <HBox>
                                    <Text text="{grave>InvoiceNumber}" />
                                    <Text
                                        text="{path: 'grave>RevisionNumber', formatter: '.formatRevisionBadge'}"
                                        class="sapUiTinyMarginBegin"
                                    />
                                </HBox>
                                <Text
                                    text="{path: 'grave>GeneratedAt', formatter: '.formatDate'}"
                                />
                                <Text
                                    text="{path: 'grave>GrossTotal', formatter: '.formatAmount'}"
                                />
                                <ObjectStatus
                                    text="{path: 'grave>PaidOn', formatter: '.paidStatusText'}"
                                    state="{path: 'grave>PaidOn', formatter: '.paidStatusState'}"
                                    stateAnnouncementText="{path: 'grave>PaidOn', formatter: '.paidStatusAnnouncement'}"
                                />
                                <HBox wrap="Wrap">
                                    <Button
                                        icon="sap-icon://detail-view"
                                        type="Transparent"
                                        tooltip="{i18n>actionDetails}"
                                        press=".onShowInvoiceDetails"
                                    />
                                    <Button
                                        icon="sap-icon://pdf-attachment"
                                        type="Transparent"
                                        tooltip="{i18n>actionDownloadNormal}"
                                        press=".onDownloadInvoiceNormal"
                                    />
                                    <Button
                                        icon="sap-icon://copy"
                                        type="Transparent"
                                        tooltip="{i18n>actionDownloadCopy}"
                                        press=".onDownloadInvoiceCopy"
                                    />
                                    <Button
                                        icon="sap-icon://edit"
                                        type="Transparent"
                                        enabled="{path: 'grave>PaidOn', formatter: '.paidEditEnabled'}"
                                        tooltip="{path: 'grave>PaidOn', formatter: '.paidEditTooltip'}"
                                        press=".onEditGraveInvoice"
                                    />
                                    <Button
                                        icon="{path: 'grave>PaidOn', formatter: '.paidActionIcon'}"
                                        type="Transparent"
                                        tooltip="{path: 'grave>PaidOn', formatter: '.paidActionTooltip'}"
                                        press=".onToggleInvoicePaid"
                                    />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>
        </content>
    </Page>
</mvc:View>
