<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core"
    controllerName="burkard.invoicing.controller.Graves" displayBlock="true">
    <tnt:ToolPage>
        <tnt:sideContent>
            <tnt:SideNavigation>
                <tnt:item>
                    <core:Fragment fragmentName="burkard.invoicing.view.fragments.Navigation" type="XML" />
                </tnt:item>
            </tnt:SideNavigation>
        </tnt:sideContent>
        <tnt:mainContents>
            <Page title="{i18n>menuGraves}" titleLevel="H1">
                <subHeader>
                    <Toolbar>
                        <Label text="{i18n>halfYear}" labelFor="halfYearSelect" />
                        <Select id="halfYearSelect" width="10rem" selectedKey="2026-1" change="onHalfYearChange">
                            <core:Item key="2026-1" text="H1 2026" />
                            <core:Item key="2026-2" text="H2 2026" />
                            <core:Item key="2025-1" text="H1 2025" />
                            <core:Item key="2025-2" text="H2 2025" />
                        </Select>
                        <ToolbarSpacer />
                        <Button text="{i18n>createGrave}" press="onCreateGrave" />
                        <Button text="{i18n>generateInvoices}" press="onGenerateInvoices" type="Emphasized" />
                    </Toolbar>
                </subHeader>
                <content>
                    <Table id="gravesTable" items="{path: 'odata>/Graves', parameters: {$orderby: 'Id desc'}}">
                        <columns>
                            <Column><Text text="{i18n>graveNumber}" /></Column>
                            <Column><Text text="{i18n>startDate}" /></Column>
                            <Column><Text text="{i18n>endDate}" /></Column>
                            <Column><Text text="{i18n>invoicingStatus}" /></Column>
                            <Column />
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{odata>GraveNumber}" />
                                    <Text text="{path: 'odata>StartDate', formatter: '.formatDate'}" />
                                    <Text text="{path: 'odata>EndDate', formatter: '.formatDate'}" />
                                    <Text text="{parts: [{path: 'odata>Id'}, {path: 'status>/statuses'}], formatter: '.statusFormatter'}" />
                                    <Button text="{i18n>edit}" press="onEditGrave" type="Transparent" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
            </Page>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>

