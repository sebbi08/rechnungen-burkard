<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="burkard.invoicing.controller.Graves"
    displayBlock="true"
>
    <Page
        title="{i18n>menuGraves}"
        titleLevel="H1"
        showNavButton="true"
        navButtonPress=".onNavBack"
        class="sapUiResponsiveContentPadding"
    >
        <subHeader>
            <!-- the half-year label and its select share a group so they always
                 move into the "..." menu together -->
            <OverflowToolbar id="gravesToolbar">
                <SearchField
                    width="16rem"
                    search=".onSearchGraves"
                    placeholder="{i18n>searchGrave}"
                >
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" />
                    </layoutData>
                </SearchField>
                <Label text="{i18n>halfYear}" labelFor="halfYearSelect">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" group="1" />
                    </layoutData>
                </Label>
                <Select
                    id="halfYearSelect"
                    width="10rem"
                    change=".onHalfYearChange"
                    items="{view>/halfYearOptions}"
                    selectedKey="{view>/halfYear}"
                >
                    <core:Item key="{view>key}" text="{view>text}" />
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" group="1" />
                    </layoutData>
                </Select>
                <Label text="{i18n>paymentFilter}" labelFor="paymentFilter">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" group="2" />
                    </layoutData>
                </Label>
                <Select
                    id="paymentFilter"
                    width="10rem"
                    change=".onPaymentFilterChange"
                    selectedKey="{view>/paymentFilter}"
                >
                    <core:Item key="all" text="{i18n>paymentFilterAll}" />
                    <core:Item key="unpaid" text="{i18n>paymentFilterUnpaid}" />
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" group="2" />
                    </layoutData>
                </Select>
                <ToolbarSpacer />
                <Button text="{i18n>bulkGraveInvoices}" press=".onBulkGraveInvoices">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" />
                    </layoutData>
                </Button>
                <Button text="{i18n>createGrave}" press=".onCreateGrave">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" />
                    </layoutData>
                </Button>
                <Button
                    text="{i18n>generateInvoices}"
                    press=".onGenerateInvoices"
                    type="Emphasized"
                >
                    <layoutData>
                        <OverflowToolbarLayoutData priority="High" />
                    </layoutData>
                </Button>
            </OverflowToolbar>
        </subHeader>
        <content>
            <!-- rows come from the half-year status endpoint, which lists the graves
                 still open for the selected half-year first (FR-028) -->
            <Table
                id="gravesTable"
                class="sapUiSmallMarginTop"
                autoPopinMode="true"
                popinLayout="Block"
                items="{status>/graves}"
                noDataText="{i18n>noData}"
            >
                <columns>
                    <Column importance="High">
                        <Text text="{i18n>graveNumber}" />
                    </Column>
                    <Column importance="Low" popinDisplay="Inline">
                        <Text text="{i18n>startDate}" />
                    </Column>
                    <Column importance="Low" popinDisplay="Inline">
                        <Text text="{i18n>endDate}" />
                    </Column>
                    <Column importance="High" popinDisplay="Inline">
                        <Text text="{i18n>invoicingStatus}" />
                    </Column>
                    <Column importance="High" popinDisplay="Inline">
                        <Text text="{i18n>paidStatus}" />
                    </Column>
                    <Column width="7rem" importance="Low" popinDisplay="WithoutHeader" />
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{status>GraveNumber}" />
                            <Text text="{path: 'status>StartDate', formatter: '.formatDate'}" />
                            <Text text="{path: 'status>EndDate', formatter: '.formatDate'}" />
                            <ObjectStatus
                                text="{path: 'status>Invoiced', formatter: '.statusFormatter'}"
                                stateAnnouncementText="{path: 'status>Invoiced', formatter: '.statusAnnouncement'}"
                                state="{= ${status>Invoiced} ? 'Success' : 'Error' }"
                                icon="{= ${status>Invoiced} ? 'sap-icon://accept' : 'sap-icon://error' }"
                            />
                            <!-- empty while the half-year has no invoice: the
                                 status beside it already reports that in red -->
                            <ObjectStatus
                                text="{parts: ['status>InvoiceCount', 'status>PaidCount'], formatter: '.paymentText'}"
                                state="{parts: ['status>InvoiceCount', 'status>PaidCount'], formatter: '.paymentState'}"
                                stateAnnouncementText="{parts: ['status>InvoiceCount', 'status>PaidCount'], formatter: '.paymentAnnouncement'}"
                                visible="{= ${status>InvoiceCount} > 0}"
                            />
                            <HBox wrap="Wrap">
                                <Button
                                    icon="sap-icon://detail-view"
                                    type="Transparent"
                                    tooltip="{i18n>actionDetails}"
                                    press=".onShowGraveDetails"
                                />
                                <Button
                                    icon="sap-icon://edit"
                                    type="Transparent"
                                    tooltip="{i18n>actionEdit}"
                                    press=".onEditGrave"
                                />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
