<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core"
    controllerName="burkard.invoicing.controller.Graves" displayBlock="true">
    <Page title="{i18n>menuGraves}" titleLevel="H1" showNavButton="true"
        navButtonPress=".onNavBack" class="sapUiResponsiveContentPadding">
        <subHeader>
            <Toolbar>
                <SearchField width="16rem" search=".onSearchGraves" placeholder="{i18n>searchGrave}" />
                <Label text="{i18n>halfYear}" labelFor="halfYearSelect" />
                <Select id="halfYearSelect" width="10rem" change=".onHalfYearChange" />
                <ToolbarSpacer />
                <Button text="{i18n>createGrave}" press=".onCreateGrave" />
                <Button text="{i18n>generateInvoices}" press=".onGenerateInvoices" type="Emphasized" />
            </Toolbar>
        </subHeader>
        <content>
            <Table id="gravesTable" class="sapUiSmallMarginTop"
                items="{path: 'odata>/Graves', parameters: {$orderby: 'Id desc'}}"
                noDataText="{i18n>noData}">
                        <columns>
                            <Column><Text text="{i18n>graveNumber}" /></Column>
                            <Column><Text text="{i18n>startDate}" /></Column>
                            <Column><Text text="{i18n>endDate}" /></Column>
                            <Column><Text text="{i18n>invoicingStatus}" /></Column>
                            <Column />
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{odata>GraveNumber}" />
                                    <Text text="{path: 'odata>StartDate', formatter: '.formatDate'}" />
                                    <Text text="{path: 'odata>EndDate', formatter: '.formatDate'}" />
                                    <Text core:require="{Integer: 'sap/ui/model/type/Integer'}"
                                        text="{parts: [{path: 'odata>Id', type: 'Integer', formatOptions: {groupingEnabled: false}}, {path: 'status>/statuses'}], formatter: '.statusFormatter'}" />
                                    <Button text="{i18n>edit}" press=".onEditGrave" type="Transparent" />
                                </cells>
                            </ColumnListItem>
                        </items>
            </Table>
        </content>
    </Page>
</mvc:View>
