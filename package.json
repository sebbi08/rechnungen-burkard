{
  "name": "rechnungen-burkard",
  "version": "0.0.0",
  "private": true,
  "description": "Repository tooling only: commit linting, git hooks and the release scripts. The application lives in frontend/ and backend/.",
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint",
    "release": "scripts/release.sh",
    "test:release": "scripts/test-release-scripts.sh",
    "format": "prettier --write . && scripts/csharpier.sh format .",
    "format:check": "prettier --check . && scripts/csharpier.sh check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@prettier/plugin-xml": "^3.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6"
  }
}
