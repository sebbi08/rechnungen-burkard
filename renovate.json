{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "automerge": false,
  "lockFileMaintenance": { "enabled": false },
  "packageRules": [
    {
      "description": "Nie automatisch mergen",
      "matchPackageNames": ["*"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": ".NET-SDK-Image in den Hilfsskripten unter scripts/",
      "managerFilePatterns": ["/(^|/)scripts/[^/]+\\.sh$/"],
      "matchStrings": ["(?<depName>mcr\\.microsoft\\.com/dotnet/sdk):(?<currentValue>[^\\s\"']+)"],
      "datasourceTemplate": "docker"
    }
  ]
}
